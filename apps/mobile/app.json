{
  "expo": {
    "name": "BARQ",
    "slug": "BARQ",
    "scheme": "BARQ",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#f2f2f3"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "om.BARQ.app",
      "supportsTablet": false
    },
    "android": {
      "package": "om.BARQ.app"
    },
    "plugins": ["expo-router"],
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
